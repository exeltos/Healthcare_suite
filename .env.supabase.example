# Copy this file to .env.local for LOCAL testing against your real Supabase project.
# Replace the two placeholders with values from Supabase Project Settings -> API.
#
# IMPORTANT:
# - Use the Publishable/Anon key only.
# - NEVER use the service_role/secret key in a VITE_* variable.

VITE_APP_MODE=production
VITE_AUTH_PROVIDER=supabase
VITE_DATA_PROVIDER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SESSION_IDLE_MINUTES=30

# Optional explicit reset URL. Must also be allowed in Supabase Auth URL Configuration.
# VITE_AUTH_REDIRECT_URL=https://YOUR_NETLIFY_DOMAIN/reset-password
