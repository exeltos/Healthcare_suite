{
  "name": "healthcare-suite",
  "private": true,
  "version": "0.12.0-rc.217",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "check:syntax": "node tools/check-syntax.mjs",
    "audit:canonical": "node tools/canonical-release-suite.mjs",
    "check": "npm run audit:canonical && npm run check:syntax",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:static": "node tools/canonical-release-suite.mjs",
    "release:verify": "npm run release:preflight && npm run release:static && npm run check:syntax && npm run build",
    "audit:deployment": "node scripts/audit-deployment-readiness.mjs",
    "audit:supabase": "node scripts/audit-supabase-readiness.mjs",
    "audit:persistence": "node scripts/audit-production-persistence.mjs",
    "audit:fail-closed": "node scripts/audit-production-fail-closed.mjs",
    "audit:clinical-write": "node scripts/audit-clinical-write-verification.mjs",
    "audit:hospital-e2e": "node scripts/audit-hospital-e2e-readiness.mjs",
    "e2e:supabase-clinical": "node scripts/e2e-supabase-clinical-contract.mjs",
    "e2e:release": "node scripts/e2e-supabase-clinical-contract.mjs --strict",
    "e2e:hospital-workflows": "node scripts/e2e-hospital-workflows.mjs",
    "e2e:hospital-release": "node scripts/e2e-hospital-workflows.mjs --strict"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "@supabase/supabase-js": "^2.0.0",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
