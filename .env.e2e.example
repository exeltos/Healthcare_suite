# Healthcare Suite live Supabase E2E — TEST PROJECT / TEST ORGANIZATIONS ONLY
# Never commit real passwords. Set these in your shell or CI secret store.
E2E_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
E2E_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Active test user in Organization A with clinical write permissions.
E2E_USER_A_EMAIL=e2e-admin-a@example.invalid
E2E_USER_A_PASSWORD=CHANGE_ME

# Strongly recommended: active test user in a DIFFERENT Organization B.
# Enables the real cross-tenant RLS test.
E2E_USER_B_EMAIL=e2e-admin-b@example.invalid
E2E_USER_B_PASSWORD=CHANGE_ME

# Full hospital workflow E2E (clinical + staff + WHO + quality + committees + documents)
# Uses the same credentials above.
# Standard run: npm run e2e:hospital-workflows
# Strict release run (requires User B in a DIFFERENT organization): npm run e2e:hospital-release
