# =========================
# LOCAL / DEMO DEVELOPMENT
# =========================
VITE_APP_MODE=demo
VITE_AUTH_PROVIDER=demo-session
VITE_DATA_PROVIDER=browser-local

# =========================
# PRODUCTION WITH SUPABASE
# =========================
# VITE_APP_MODE=production
# VITE_AUTH_PROVIDER=supabase
# VITE_DATA_PROVIDER=supabase
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# VITE_AUTH_REDIRECT_URL=https://your-production-domain.example/login

# Never place a Supabase secret/service-role key in VITE_* variables or frontend code.
